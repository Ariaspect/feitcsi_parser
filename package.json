{
  "name": "feitcsi-parser",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:all": "concurrently -n backend,frontend -c blue,green \"uv run uvicorn backend.app:app --reload --port 8000\" \"npm --prefix frontend run dev\"",
    "dev:backend": "uv run uvicorn backend.app:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "serve": "uv run uvicorn backend.app:app --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
